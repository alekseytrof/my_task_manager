<Window x:Class="MyTaskManager.Client.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyTaskManager.Client.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Login"
        Height="300" Width="400"
        ResizeMode="NoResize"
        Name ="window"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Width="250">
            <TextBox Text="{Binding UserLogin}" Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     Margin="0,3"/>
            <PasswordBox x:Name="UserPassword" Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                     Margin="0,3"/>
            <Button Content="OK" Command="{Binding GetUserFromDBCommand}"
                    CommandParameter="{Binding ElementName=UserPassword}"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Width="100"
                    Margin="0,5"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentUserCache}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Setter Property="Height" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Предыдущий пользователь" Style="{StaticResource MaterialDesignButtonTextBlock}"
                       Margin="5,0,0,0"/>
            <Button Content="{Binding CurrentUserCache.Login}"
                    Command="{Binding LoginFromCacheCommand}"
                    CommandParameter="{Binding ElementName=window}"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Margin="5,0,5,5"/>
        </StackPanel>
    </Grid>
</Window>
